{
  "name": "@findemy/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.seed.json",
    "lint": "biome check .",
    "test": "vitest",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "clean": "rm -rf dist",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "seed:admin": "tsx prisma/seed-admin.ts",
    "seed:staff-roles": "tsx prisma/seed-staff-roles.ts",
    "seed:batches": "tsx scripts/seed-batches.ts",
    "seed:academy": "tsx scripts/seed-academy-demo.ts",
    "worker": "tsx src/workers/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@fastify/cors": "^10.1.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/websocket": "^11.3.0",
    "@findemy/types": "workspace:*",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.0.0",
    "dotenv": "^16.4.0",
    "expo-server-sdk": "^3.13.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "ioredis": "^5.4.0",
    "jose": "^5.9.0",
    "node-cron": "^4.2.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0",
    "razorpay": "^2.9.0",
    "sanitize-html": "^2.17.5",
    "ulidx": "^2.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@findemy/config": "workspace:*",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
