NODE_ENV=development
PORT=8080
MOCK=0

DATABASE_URL=postgres://findemy:findemy@localhost:5432/findemy
REDIS_URL=redis://localhost:6379

JWT_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# 100ms (online live classes). Leave blank for local dev (mock token, no live A/V).
HMS_ACCESS_KEY=
HMS_SECRET=
HMS_MANAGEMENT_TOKEN=
HMS_TEMPLATE_ID=
HMS_WEBHOOK_SECRET=

# AWS S3 media. Leave S3_BUCKET blank for local-disk uploads. Prod uses the ECS task role (no keys).
S3_BUCKET=
S3_PRIVATE_BUCKET=
S3_REGION=ap-south-1
# CloudFront domain in front of S3_BUCKET, e.g. https://media.findemy.com
S3_PUBLIC_BASE_URL=

GOOGLE_GEOCODING_KEY=
EXPO_ACCESS_TOKEN=
SENTRY_DSN=

APPLE_STUDENT_BUNDLE_ID=
APPLE_ADMIN_BUNDLE_ID=
GOOGLE_STUDENT_IOS_CLIENT_ID=
GOOGLE_STUDENT_ANDROID_CLIENT_ID=
GOOGLE_ADMIN_IOS_CLIENT_ID=
GOOGLE_ADMIN_ANDROID_CLIENT_ID=
